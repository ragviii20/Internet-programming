
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GrandStay Hotel Booking</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6f9;
    color: #333;
}

header {
    background: #12304a;
    color: white;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

header h1 {
    font-size: 25px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
    cursor: pointer;
}

nav a:hover {
    color: #f5c16c;
}

.hero {
    min-height: 340px;
    padding: 65px 20px;
    text-align: center;
    color: white;
    background:
      linear-gradient(#09243ab8, #09243ab8),
      url("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1500&q=80")
      center/cover;
}

.hero h2 {
    font-size: 38px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 17px;
    margin-bottom: 25px;
}

.search-box {
    max-width: 950px;
    margin: -35px auto 30px;
    position: relative;
    background: white;
    padding: 22px;
    border-radius: 12px;
    box-shadow: 0 5px 20px #0002;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
}

input, select, textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
}

button {
    padding: 11px 17px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    background: #e8a844;
    color: #172d40;
    font-weight: bold;
}

button:hover {
    opacity: 0.85;
}

.container {
    max-width: 1150px;
    margin: 35px auto;
    padding: 0 20px;
}

h2.section-title {
    text-align: center;
    margin-bottom: 25px;
    color: #12304a;
}

.rooms {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 22px;
}

.room {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 12px #0001;
}

.room img {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.room-info {
    padding: 18px;
}

.room-info h3 {
    margin-bottom: 10px;
    color: #12304a;
}

.room-info p {
    margin-bottom: 10px;
    line-height: 1.5;
}

.price {
    color: #bd7919;
    font-size: 21px;
    font-weight: bold;
    margin: 12px 0;
}

.room-info button {
    width: 100%;
}

.panel {
    background: white;
    padding: 22px;
    border-radius: 10px;
    margin-bottom: 22px;
    box-shadow: 0 3px 12px #0001;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
}

.form-group label {
    display: block;
    font-weight: bold;
    margin-bottom: 7px;
}

.form-group {
    margin-bottom: 10px;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
}

th, td {
    padding: 12px;
    border-bottom: 1px solid #ddd;
    text-align: left;
}

th {
    background: #12304a;
    color: white;
}

.table-wrap {
    overflow-x: auto;
}

.hidden {
    display: none !important;
}

.notice {
    background: #eaf3fb;
    padding: 14px;
    border-radius: 7px;
    margin-bottom: 15px;
    line-height: 1.5;
}

footer {
    background: #12304a;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 45px;
}

footer p {
    margin: 7px;
}

.status {
    font-weight: bold;
    color: #21834b;
}

.cancel {
    background: #c0392b;
    color: white;
}

@media(max-width: 600px) {
    header {
        padding: 18px;
    }

    nav a {
        display: inline-block;
        margin: 8px 10px 0 0;
    }

    .hero h2 {
        font-size: 28px;
    }

    .search-box {
        margin: 15px;
    }

    .container {
        margin-top: 25px;
    }
}
</style>
</head>

<body>

<header>
    <h1>🏨 GrandStay Hotel</h1>
    <nav>
        <a onclick="showPage('home')">Home</a>
        <a onclick="showPage('rooms')">Rooms</a>
        <a onclick="showPage('bookings')">My Bookings</a>
        <a onclick="showPage('login')">Login</a>
        <a onclick="showPage('admin')">Admin</a>
    </nav>
</header>

<section class="hero" id="hero">
    <h2>Find Your Perfect Stay</h2>
    <p>Comfort, luxury and memorable experiences at affordable prices.</p>
</section>

<!-- ROOM SEARCH -->
<div class="search-box" id="searchBox">
    <input type="text" id="destination" placeholder="Destination / Hotel">
    <div>
        <label for="checkin">Check-in</label>
        <input type="date" id="checkin">
    </div>
    <div>
        <label for="checkout">Check-out</label>
        <input type="date" id="checkout">
    </div>
    <select id="guests">
        <option value="1">1 Guest</option>
        <option value="2" selected>2 Guests</option>
        <option value="3">3 Guests</option>
        <option value="4">4 Guests</option>
    </select>
    <button onclick="searchRooms()">Search Rooms</button>
</div>

<main class="container">

<!-- HOME AND ROOMS -->
<section id="homePage">
    <h2 class="section-title">Our Available Rooms</h2>
    <div class="rooms" id="roomList"></div>
</section>

<section id="roomsPage" class="hidden">
    <h2 class="section-title">Explore Our Rooms</h2>
    <div class="rooms" id="allRooms"></div>
</section>

<!-- LOGIN -->
<section id="loginPage" class="hidden">
    <div class="panel">
        <h2>Guest Login / Registration</h2>
        <p style="margin:12px 0">Enter your details to manage your bookings.</p>

        <form onsubmit="loginGuest(event)">
            <div class="form-grid">
                <div class="form-group">
                    <label>Full Name</label>
                    <input id="guestName" required placeholder="Your full name">
                </div>
                <div class="form-group">
                    <label>Email Address</label>
                    <input id="guestEmail" type="email" required placeholder="you@example.com">
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input id="guestPhone" type="tel" required placeholder="Phone number">
                </div>
            </div>
            <button type="submit">Continue</button>
        </form>
        <p id="loginMessage" style="margin-top:15px"></p>
    </div>
</section>

<!-- BOOKING HISTORY -->
<section id="bookingsPage" class="hidden">
    <div class="panel">
        <h2>My Bookings</h2>
        <p style="margin:12px 0">View and manage your reservations.</p>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Guest</th>
                        <th>Room</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="bookingRows"></tbody>
            </table>
        </div>
    </div>
</section>

<!-- ADMIN PANEL -->
<section id="adminPage" class="hidden">
    <div class="panel">
        <h2>Administrator Login</h2>
        <p style="margin:12px 0">Demo credentials: admin / admin123</p>

        <form onsubmit="adminLogin(event)">
            <div class="form-grid">
                <input id="adminUser" placeholder="Username" required>
                <input id="adminPass" type="password" placeholder="Password" required>
            </div>
            <br>
            <button type="submit">Login as Admin</button>
        </form>
        <p id="adminMessage" style="margin-top:12px"></p>
    </div>

    <div id="adminDashboard" class="hidden">
        <div class="panel">
            <h2>Booking Management</h2>
            <p id="adminStats" style="margin-top:12px"></p>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Guest</th>
                            <th>Room</th>
                            <th>Dates</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="adminRows"></tbody>
                </table>
            </div>
        </div>

        <div class="panel">
            <h2>Update Room Price</h2>
            <form onsubmit="updatePrice(event)">
                <div class="form-grid">
                    <select id="priceRoom"></select>
                    <input type="number" id="newPrice" min="1" required placeholder="New price per night (₹)">
                </div>
                <br>
                <button type="submit">Update Price</button>
            </form>
        </div>
    </div>
</section>

<!-- ABOUT -->
<section class="panel" id="aboutSection">
    <h2>About GrandStay Hotel</h2>
    <p style="margin-top:12px;line-height:1.7">
        GrandStay Hotel offers comfortable accommodation, quality service,
        modern facilities and convenient online reservations. Choose a room,
        select your dates and reserve your stay in just a few steps.
    </p>
</section>

</main>

<footer>
    <h3>GrandStay Hotel</h3>
    <p>Comfort • Luxury • Hospitality</p>
    <p>Contact: reservations@grandstay.example</p>
    <p>© 2026 GrandStay Hotel | Internet Programming Lab Project</p>
</footer>

<script>
// Sample room information
let rooms = [
    {
        id: 1,
        name: "Standard Room",
        price: 2500,
        capacity: 2,
        quantity: 5,
        image: "https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=700&q=80",
        description: "A comfortable room for solo travellers and couples."
    },
    {
        id: 2,
        name: "Deluxe Room",
        price: 4000,
        capacity: 3,
        quantity: 4,
        image: "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=700&q=80",
        description: "Spacious accommodation with premium facilities."
    },
    {
        id: 3,
        name: "Family Suite",
        price: 6500,
        capacity: 4,
        quantity: 3,
        image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=700&q=80",
        description: "Extra space and comfort for family holidays."
    },
    {
        id: 4,
        name: "Luxury Suite",
        price: 9000,
        capacity: 4,
        quantity: 2,
        image: "https://images.unsplash.com/photo-1618773928121-c32242e63f39?auto=format&fit=crop&w=700&q=80",
        description: "Elegant interiors for a premium hotel experience."
    }
];

let bookings = JSON.parse(localStorage.getItem("hotelBookings") || "[]");
let guest = JSON.parse(localStorage.getItem("hotelGuest") || "null");
let isAdmin = false;

const $ = id => document.getElementById(id);

function saveData() {
    localStorage.setItem("hotelBookings", JSON.stringify(bookings));
    localStorage.setItem("hotelGuest", JSON.stringify(guest));
}

function dateToday() {
    const d = new Date();
    return d.getFullYear() + "-" +
        String(d.getMonth() + 1).padStart(2, "0") + "-" +
        String(d.getDate()).padStart(2, "0");
}

$("checkin").min = dateToday();
$("checkout").min = dateToday();

$("checkin").addEventListener("change", () => {
    $("checkout").min = $("checkin").value || dateToday();
    if ($("checkout").value <= $("checkin").value) {
        $("checkout").value = "";
    }
});

function escapeHTML(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[c]);
}

function availableRooms(room, start, end) {
    let occupied = bookings.filter(b =>
        b.roomId === room.id &&
        b.status === "Confirmed" &&
        b.checkin < end &&
        b.checkout > start
    ).length;

    return room.quantity - occupied;
}

function renderRooms(target = "roomList", filter = false) {
    const start = $("checkin").value;
    const end = $("checkout").value;
    const guests = Number($("guests").value);
    const destination = $("destination").value.trim().toLowerCase();

    let list = rooms.filter(room => {
        if (room.capacity < guests) return false;

        if (filter && destination &&
            !("grandstay hotel " + room.name).toLowerCase().includes(destination)) {
            return false;
        }

        if (filter && start && end &&
            (end <= start || availableRooms(room, start, end) < 1)) {
            return false;
        }

        return true;
    });

    $(target).innerHTML = list.length ? list.map(room => `
        <article class="room">
            <img src="${room.image}" alt="${escapeHTML(room.name)}">
            <div class="room-info">
                <h3>${escapeHTML(room.name)}</h3>
                <p>${escapeHTML(room.description)}</p>
                <p>Maximum guests: ${room.capacity}</p>
                <div class="price">₹${room.price.toLocaleString("en-IN")} / night</div>
                <button onclick="startBooking(${room.id})">Book Now</button>
            </div>
        </article>
    `).join("") : "<p>No matching rooms available. Try different dates or guest numbers.</p>";
}

function searchRooms() {
    const start = $("checkin").value;
    const end = $("checkout").value;

    if (start && end && end <= start) {
        alert("Check-out must be after check-in.");
        return;
    }

    showPage("rooms");
    renderRooms("allRooms", true);
}

function showPage(page) {
    ["home", "rooms", "bookings", "login", "admin"].forEach(name => {
        $(name + "Page").classList.toggle("hidden", name !== page);
    });

    $("hero").classList.toggle("hidden", page !== "home");
    $("searchBox").classList.toggle("hidden", page !== "home" && page !== "rooms");
    $("aboutSection").classList.toggle("hidden", page !== "home");

    if (page === "home") renderRooms("roomList");
    if (page === "rooms") renderRooms("allRooms", false);
    if (page === "bookings") renderBookings();
    if (page === "admin") renderAdmin();
}

function startBooking(roomId) {
    if (!guest) {
        alert("Please log in or register before booking a room.");
        showPage("login");
        return;
    }

    const start = $("checkin").value;
    const end = $("checkout").value;

    if (!start || !end || end <= start) {
        alert("Please select valid check-in and check-out dates first.");
        $("checkin").focus();
        return;
    }

    const room = rooms.find(r => r.id === roomId);
    if (!room) return;

    if (Number($("guests").value) > room.capacity) {
        alert("This room cannot accommodate that many guests.");
        return;
    }

    if (availableRooms(room, start, end) < 1) {
        alert("Sorry, this room is unavailable for those dates.");
        renderRooms("allRooms", true);
        return;
    }

    const nights = Math.round(
        (new Date(end + "T00:00:00") - new Date(start + "T00:00:00")) / 86400000
    );

    const total = nights * room.price;

    if (!confirm(
        "Room: " + room.name +
        "\nCheck-in: " + start +
        "\nCheck-out: " + end +
        "\nGuests: " + $("guests").value +
        "\nNights: " + nights +
        "\nTotal: ₹" + total.toLocaleString("en-IN") +
        "\n\nConfirm this demo reservation?"
    )) return;

    const booking = {
        id: "GS" + Date.now().toString().slice(-8),
        roomId: room.id,
        roomName: room.name,
        guestName: guest.name,
        email: guest.email,
        phone: guest.phone,
        guests: Number($("guests").value),
        checkin: start,
        checkout: end,
        nights: nights,
        total: total,
        status: "Confirmed",
        created: new Date().toISOString()
    };

    bookings.push(booking);
    saveData();

    alert("Booking successful!\nYour booking ID is " + booking.id);
    showPage("bookings");
}

function loginGuest(event) {
    event.preventDefault();

    guest = {
        name: $("guestName").value.trim(),
        email: $("guestEmail").value.trim(),
        phone: $("guestPhone").value.trim()
    };

    saveData();

    $("loginMessage").textContent =
        "Welcome, " + guest.name + "! You can now book rooms.";

    $("loginMessage").style.color = "green";
    renderRooms("roomList");
}

function renderBookings() {
    const list = bookings.filter(b =>
        guest && b.email.toLowerCase() === guest.email.toLowerCase()
    );

    $("bookingRows").innerHTML = list.length ? list.map(b => `
        <tr>
            <td>${escapeHTML(b.id)}</td>
            <td>${escapeHTML(b.guestName)}</td>
            <td>${escapeHTML(b.roomName)}</td>
            <td>${b.checkin}</td>
            <td>${b.checkout}</td>
            <td>₹${b.total.toLocaleString("en-IN")}</td>
            <td>${escapeHTML(b.status)}</td>
            <td>${b.status === "Confirmed" && b.checkin > dateToday()
                ? `<button class="cancel" onclick="cancelBooking('${b.id}')">Cancel</button>`
                : "—"}</td>
        </tr>
    `).join("") : `
        <tr><td colspan="8">
            ${guest ? "You have no bookings yet." : "Please log in to view your bookings."}
        </td></tr>
    `;
}

function cancelBooking(id) {
    const booking = bookings.find(b => b.id === id);

    if (!booking || booking.status !== "Confirmed") return;

    const daysUntil = Math.floor(
        (new Date(booking.checkin + "T00:00:00") -
        new Date(dateToday() + "T00:00:00")) / 86400000
    );

    if (daysUntil < 3) {
        alert("Demo policy: bookings can only be cancelled at least 3 days before check-in.");
        return;
    }

    if (confirm("Cancel booking " + id + "?")) {
        booking.status = "Cancelled";
        saveData();
        renderBookings();
        alert("Booking cancelled successfully.");
    }
}

function adminLogin(event) {
    event.preventDefault();

    if ($("adminUser").value === "admin" &&
        $("adminPass").value === "admin123") {
        isAdmin = true;
        $("adminMessage").textContent = "Administrator login successful.";
        $("adminMessage").style.color = "green";
        $("adminDashboard").classList.remove("hidden");
        renderAdmin();
    } else {
        $("adminMessage").textContent = "Invalid username or password.";
        $("adminMessage").style.color = "red";
    }
}

function renderAdmin() {
    if (!isAdmin) return;

    $("adminStats").textContent =
        "Total bookings: " + bookings.length +
        " | Confirmed: " + bookings.filter(b => b.status === "Confirmed").length +
        " | Cancelled: " + bookings.filter(b => b.status === "Cancelled").length;

    $("adminRows").innerHTML = bookings.length ? bookings.map(b => `
        <tr>
            <td>${escapeHTML(b.id)}</td>
            <td>${escapeHTML(b.guestName)}</td>
            <td>${escapeHTML(b.roomName)}</td>
            <td>${b.checkin} to ${b.checkout}</td>
            <td>₹${b.total.toLocaleString("en-IN")}</td>
            <td>${escapeHTML(b.status)}</td>
            <td>${b.status === "Confirmed"
                ? `<button class="cancel" onclick="adminCancel('${b.id}')">Cancel</button>`
                : "—"}</td>
        </tr>
    `).join("") : `<tr><td colspan="7">No bookings available.</td></tr>`;

    $("priceRoom").innerHTML = rooms.map(r =>
        `<option value="${r.id}">${escapeHTML(r.name)} — ₹${r.price}</option>`
    ).join("");
}

function adminCancel(id) {
    if (!isAdmin) return;

    const booking = bookings.find(b => b.id === id);
    if (!booking || booking.status !== "Confirmed") return;

    if (confirm("Cancel booking " + id + "?")) {
        booking.status = "Cancelled";
        saveData();
        renderAdmin();
        alert("Booking cancelled.");
    }
}

function updatePrice(event) {
    event.preventDefault();
    if (!isAdmin) return;

    const room = rooms.find(r => r.id === Number($("priceRoom").value));
    const price = Number($("newPrice").value);

    if (!room || price <= 0) {
        alert("Enter a valid room price.");
        return;
    }

    room.price = price;
    renderRooms("roomList");
    renderRooms("allRooms");
    renderAdmin();

    alert("Room price updated for this session.");
}

// Initial page
renderRooms("roomList");
</script>

</body>
</html>
